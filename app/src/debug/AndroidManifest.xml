<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".diagnostics.RuntimeDiagnosticsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.ardogdemo.diagnostics.RESET_FRAMES" />
                <action android:name="com.example.ardogdemo.diagnostics.DUMP" />
                <action android:name="com.example.ardogdemo.diagnostics.SET_SCENARIO" />
                <action android:name="com.example.ardogdemo.diagnostics.TEARDOWN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
